# ============================================================
# .dockerignore — reduz o contexto enviado ao daemon Docker
# ============================================================

# Dependências e builds locais
node_modules
.output
dist
build
.vite
.cache

# Git e metadata
.git
.gitignore
.github

# Variáveis de ambiente locais — IMPORTANTE
# .env É NECESSÁRIO no build (Vite injeta VITE_* em build-time)
# e no runtime SSR (process.env). NÃO ignorar.
# Apenas variantes locais/secundárias ficam de fora:
.env.local
.env.*.local
.env.development
.env.production

# IDE / editor
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Próprio Docker e docs
Dockerfile
Dockerfile.dev
docker-compose.yml
.dockerignore
README.docker.md

# Workspaces de agentes/sandbox (irrelevantes em runtime)
.workspace
.agents
.claude
mem

# Backups do banco (ficam na VPS, nunca no repositório nem na imagem)
backups
