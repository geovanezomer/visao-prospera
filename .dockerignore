# ============================================================
# .dockerignore — reduz tamanho do contexto enviado ao daemon
# ============================================================

# Dependências e builds locais
node_modules
.output
dist
build
.vite
.cache

# Git e metadata
.git
.gitignore
.github

# Variáveis de ambiente locais
.env
.env.*
!.env.example

# IDE / editor
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Próprio Docker
Dockerfile
Dockerfile.dev
docker-compose.yml
.dockerignore

# Lovable / sandbox
.lovable
.workspace
.agents
.claude
mem
README.docker.md
