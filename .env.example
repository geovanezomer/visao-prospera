# Copie para .env e preencha com as credenciais do seu projeto Lovable Cloud / Supabase.
# As variáveis VITE_* são lidas em build-time pelo Vite (bundladas no client).
# As variáveis sem prefixo são lidas em runtime pelo servidor SSR.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Opcional — apenas se o servidor precisar de admin/service role:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend — envio de e-mails de sugestões/feedback (header > ícone de e-mail).
# Crie a API key em https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Remetente verificado no Resend (domínio precisa estar validado).
FEEDBACK_FROM="FinancePRO <feedback@seu-dominio.com>"
# Destinatário das sugestões.
FEEDBACK_TO=voce@seu-dominio.com

# Páginas públicas (marketing). ON | OFF
VITE_LANDING_PAGE=ON
VITE_PLANOS_PAGE=OFF

# ============================================================================
# PAGAMENTOS — Stripe (principal) ou Asaas (fallback).
#
# Seleção: defina PAYMENT_PROVIDER explicitamente (recomendado) OU deixe
# em branco e comente as chaves do provedor que NÃO quiser usar.
#   PAYMENT_PROVIDER=stripe   → usa Stripe
#   PAYMENT_PROVIDER=asaas    → usa Asaas
#   (vazio)                   → autodetecta pela chave presente
# ============================================================================
VITE_PAYMENTS_ENABLED=OFF
PAYMENT_PROVIDER=stripe

# URL pública do app (usada nos return_url/success_url do checkout).
APP_URL=https://app.seu-dominio.com.br

# ---------- STRIPE ----------
# Crie em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Crie um endpoint de webhook em https://dashboard.stripe.com/webhooks
# apontando para  ${APP_URL}/api/public/payments/webhook/stripe
# com eventos: checkout.session.completed, customer.subscription.updated,
#              customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs (price_xxx) dos produtos criados em https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_yyy

# ---------- ASAAS ----------
# ASAAS_ENV: sandbox | production
# ASAAS_ENV=sandbox
# ASAAS_API_KEY=$aact_...
# ASAAS_WEBHOOK_TOKEN=...
# Formato dos planos: "VALOR:CICLO"  (CICLO = MONTHLY | YEARLY)
# ASAAS_PLAN_STARTER=97.00:MONTHLY
# ASAAS_PLAN_PRO=297.00:MONTHLY
# Opcional — auxilia o mapeamento de webhook para plano:
# ASAAS_PRICE_STARTER=97.00
# ASAAS_PRICE_PRO=297.00
