# Copie para .env e preencha com as credenciais do seu projeto Lovable Cloud / Supabase.
# As variáveis VITE_* são lidas em build-time pelo Vite (bundladas no client).
# As variáveis sem prefixo são lidas em runtime pelo servidor SSR.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_ID

# Opcional — apenas se o servidor precisar de admin/service role:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
