# ============================================================
# FinnancePRO — .env.example
#
# Copie este arquivo para `.env` na raiz do projeto e preencha
# os valores reais ANTES de rodar `docker compose up --build`.
#
#   cp .env.example .env
#   nano .env
#
# Regras:
#   • VITE_*  → lidas em BUILD-TIME pelo Vite (bundladas no client).
#               Mudou? Rebuild obrigatório: `docker compose up app -d --build`
#   • Sem prefixo → lidas em RUNTIME pelo SSR (process.env).
#               Mudou? Basta reiniciar: `docker compose restart app`
#
# NUNCA exponha segredos (senha do banco, BETTER_AUTH_SECRET, secret keys,
# webhook secrets, HMAC) com prefixo VITE_ — iriam parar no bundle do browser.
# ============================================================


# ============================================================
# 1) BANCO — PostgreSQL 17 (obrigatório)
# ============================================================
# Com o docker compose padrão, o serviço `db` usa estas credenciais e o
# app monta a DATABASE_URL sozinho. Gere uma senha forte:
#   openssl rand -hex 24
POSTGRES_USER="financepro"
POSTGRES_PASSWORD="TROQUE_POR_UMA_SENHA_FORTE"
POSTGRES_DB="financepro"

# Só preencha para usar um Postgres EXTERNO (ex.: o mesmo servidor do Odoo,
# num banco e usuário separados). Vazio = serviço `db` do compose.
# DATABASE_URL="postgres://usuario:senha@host:5432/banco"


# ============================================================
# 1.1) LOGIN — Better Auth (dentro do próprio app)
# ============================================================
# Segredo que assina as sessões. Mínimo 32 caracteres. Gere com:
#   openssl rand -hex 32
# Trocar este valor encerra todas as sessões abertas.
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARS"

# Primeiro acesso: usuário "admin", senha "admin" — o app exige a troca
# da senha no primeiro login.


# ============================================================
# 2) APP — URL pública (usada em return_url/success_url)
# ============================================================
APP_URL="https://app.seu-dominio.com.br"
# Espelho de APP_URL para o bundle do client (canonical/OG/sitemap). Mudou? Rebuild obrigatório.
VITE_APP_URL="https://app.seu-dominio.com.br"


# ============================================================
# 3) FEATURES
# ============================================================
# Backup automático do arquivo .finnance no banco (nuvem). ON | OFF
CLOUD_BACKUP="ON"
# Landing page pública em /. ON | OFF
VITE_LANDING_PAGE="ON"
# Página pública de planos em /planos. ON | OFF (depreciada — use a landing)
VITE_PLANOS_PAGE="OFF"


# ============================================================
# 4) E-MAIL — SMTP próprio (sem custo)
# ============================================================
# Qualquer servidor SMTP serve (o mesmo configurado no Odoo do cliente,
# Gmail/Workspace, Zoho, etc.). Sem SMTP, os e-mails (reset de senha,
# links de acesso) só aparecem no log do servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"      # true para porta 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="FinnancePRO <nao-responda@seu-dominio.com>"

# Opcional: Resend no lugar do SMTP (https://resend.com/api-keys).
RESEND_API_KEY=""

# Destino das sugestões/feedback enviadas pelo app.
FEEDBACK_FROM="FinnancePRO <feedback@seu-dominio.com>"
FEEDBACK_TO="voce@seu-dominio.com"

# ---------- PROXY ----------
# Header com o IP real do cliente, definido pelo SEU proxy (usado no rate
# limit e na auditoria). Deixe vazio se o app recebe conexões diretas.
#   cf-connecting-ip → Cloudflare na frente
#   x-real-ip        → nginx com: proxy_set_header X-Real-IP $remote_addr;
#   x-forwarded-for  → usa a última entrada (a adicionada pelo proxy)
TRUST_PROXY_HEADER=""

# ---------- CRON (/api/public/hooks/*) ----------
# Os jobs (retry de webhooks, limpeza de trials, reconciliação de checkout)
# rodam dentro do próprio app. Este segredo só protege o disparo MANUAL dos
# endpoints (ex.: curl de um crontab externo). Mínimo 32 caracteres:
#   openssl rand -hex 32
CRON_SECRET=""


# ============================================================
# 5) PAGAMENTOS — Stripe (principal) ou Asaas (fallback)
# ============================================================
# ON | OFF — liga o módulo inteiro
VITE_PAYMENTS_ENABLED="OFF"

# stripe | asaas (vazio = autodetecta pela chave presente)
PAYMENT_PROVIDER="stripe"

# Segredo HMAC para assinar os tokens de checkout-intent (32+ chars).
# Gere com:  openssl rand -hex 32
CHECKOUT_INTENT_HMAC_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARS"

# Secrets dos webhooks (Stripe envia whsec_..., Asaas envia o token configurado)
PAYMENTS_LIVE_WEBHOOK_SECRET=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""

# ---------- STRIPE ----------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Webhook: ${APP_URL}/api/public/payments/webhook/stripe
# Eventos: checkout.session.completed, customer.subscription.updated,
#          customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs de preço (price_xxx) — https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER="price_xxx"
STRIPE_PRICE_PRO="price_yyy"

# ---------- ASAAS ----------
# ASAAS_ENV="sandbox"            # sandbox | production
# ASAAS_API_KEY="$aact_..."
# ASAAS_WEBHOOK_TOKEN="..."
# ASAAS_PLAN_STARTER="97.00:MONTHLY"
# ASAAS_PLAN_PRO="297.00:MONTHLY"
# ASAAS_PRICE_STARTER="97.00"
# ASAAS_PRICE_PRO="297.00"
