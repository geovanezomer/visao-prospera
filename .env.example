# ============================================================
# FinancePRO — .env.example
#
# Copie este arquivo para `.env` na raiz do projeto e preencha
# os valores reais ANTES de rodar `docker compose up --build`.
#
#   cp .env.example .env
#   nano .env
#
# Regras:
#   • VITE_*  → lidas em BUILD-TIME pelo Vite (bundladas no client).
#               Mudou? Rebuild obrigatório: `docker compose up app -d --build`
#   • Sem prefixo → lidas em RUNTIME pelo SSR (process.env).
#               Mudou? Basta reiniciar: `docker compose restart app`
#
# NUNCA exponha segredos (service role, secret keys, webhook secrets,
# HMAC) com prefixo VITE_ — eles iriam parar no bundle do browser.
# ============================================================


# ============================================================
# 1) SUPABASE — obrigatório
# ============================================================
# Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# Mesmos valores acima, sem prefixo, para o SSR.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_PROJECT_ID="YOUR_PROJECT_ID"

# Service role — OBRIGATÓRIO no VPS (admin, webhooks, backup, bootstrap).
# Dashboard → Project Settings → API → service_role (secret).
# NUNCA commitar. NUNCA prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_YOUR_SERVICE_ROLE_KEY"

# Connection string do Postgres — usada APENAS pelo bootstrap de migrations
# no boot do container (scripts/db-bootstrap.sh). Em runtime, o app fala com
# o Supabase via PostgREST (HTTPS), que já tem pooling no lado do servidor —
# então NÃO existe gargalo de conexões TCP no app.
#
# RECOMENDADO para o VPS: Session Pooler (porta 5432, suporta DDL/migrations
# e aguenta picos sem estourar as 60 conexões diretas do plano Pro):
#   Dashboard → Project Settings → Database → Connection Pooling → Session
#   postgresql://postgres.YOUR_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
#
# Alternativa: Direct connection (db.YOUR_REF.supabase.co:5432) — funciona,
# mas consome 1 das 60 conexões diretas.
#
# NÃO use Transaction Pooler (porta 6543) aqui: ele quebra migrations
# com DDL/prepared statements. Use apenas se um dia adicionar um client
# Postgres direto (Drizzle/Prisma) em queries de runtime.
#
# Deixe vazio para PULAR o bootstrap (schema já provisionado).
SUPABASE_DB_URL="postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"


# ============================================================
# 1.1) ADMIN — provisionado automaticamente no boot
# ============================================================
# Um único e-mail é considerado administrador. Se não existir em auth.users,
# o entrypoint cria via Admin API (requer SUPABASE_SERVICE_ROLE_KEY).
# Se já existir, sincroniza a senha. Idempotente.
VITE_ADMIN_EMAIL="contato@seu-dominio.com.br"
ADMIN_EMAIL="contato@seu-dominio.com.br"
ADMIN_PASSWORD="TROQUE_PARA_UMA_SENHA_FORTE"
ADMIN_DISPLAY_NAME="Administrador"


# ============================================================
# 2) APP — URL pública (usada em return_url/success_url)
# ============================================================
APP_URL="https://app.seu-dominio.com.br"
# Espelho de APP_URL para o bundle do client (canonical/OG/sitemap). Mudou? Rebuild obrigatório.
VITE_APP_URL="https://app.seu-dominio.com.br"


# ============================================================
# 3) FEATURES
# ============================================================
# Backup automático do arquivo .finnance no Supabase Storage. ON | OFF
SUPABASE_BACKUP="ON"
# Landing page pública em /. ON | OFF
VITE_LANDING_PAGE="ON"
# Página pública de planos em /planos. ON | OFF (depreciada — use a landing)
VITE_PLANOS_PAGE="OFF"


# ============================================================
# 4) E-MAIL (Resend) — sugestões/feedback
# ============================================================
# https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
FEEDBACK_FROM="FinancePRO <feedback@seu-dominio.com>"
FEEDBACK_TO="voce@seu-dominio.com"

# ---------- CRON (/api/public/hooks/*) ----------
# Segredo dedicado dos jobs agendados (retry de webhooks, limpeza de trials,
# reconciliação de checkout). Mínimo 32 caracteres. Gere com:
#   openssl rand -hex 32
# Grave o MESMO valor no Supabase Vault com o nome 'cron_secret'
# (ver supabase/migrations/20261006120100_cron_jobs_com_cron_secret.sql).
# Sem ele, os endpoints de cron recusam todos os chamados.
CRON_SECRET=""


# ============================================================
# 5) PAGAMENTOS — Stripe (principal) ou Asaas (fallback)
# ============================================================
# ON | OFF — liga o módulo inteiro
VITE_PAYMENTS_ENABLED="OFF"

# stripe | asaas (vazio = autodetecta pela chave presente)
PAYMENT_PROVIDER="stripe"

# Segredo HMAC para assinar os tokens de checkout-intent (32+ chars).
# Gere com:  openssl rand -hex 32
CHECKOUT_INTENT_HMAC_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARS"

# Secrets dos webhooks (Stripe envia whsec_..., Asaas envia o token configurado)
PAYMENTS_LIVE_WEBHOOK_SECRET=""
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""

# ---------- STRIPE ----------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Webhook: ${APP_URL}/api/public/payments/webhook/stripe
# Eventos: checkout.session.completed, customer.subscription.updated,
#          customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."
# IDs de preço (price_xxx) — https://dashboard.stripe.com/products
STRIPE_PRICE_STARTER="price_xxx"
STRIPE_PRICE_PRO="price_yyy"

# ---------- ASAAS ----------
# ASAAS_ENV="sandbox"            # sandbox | production
# ASAAS_API_KEY="$aact_..."
# ASAAS_WEBHOOK_TOKEN="..."
# ASAAS_PLAN_STARTER="97.00:MONTHLY"
# ASAAS_PLAN_PRO="297.00:MONTHLY"
# ASAAS_PRICE_STARTER="97.00"
# ASAAS_PRICE_PRO="297.00"
