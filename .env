# Service role — OBRIGATÓRIO no VPS para admin, webhooks e backup.
# Obtenha em: Supabase Dashboard → Project Settings → API → service_role
# Substitua o placeholder abaixo pela chave real antes de buildar/subir.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_YOUR_SERVICE_ROLE_KEY"

# ---------- Features ----------
# Backup automático do arquivo .finnance no Supabase Storage. ON | OFF
SUPABASE_BACKUP="ON"
# Landing page pública em /. ON | OFF
VITE_LANDING_PAGE="ON"
# Página pública de planos em /planos. ON | OFF
VITE_PLANOS_PAGE="OFF"
